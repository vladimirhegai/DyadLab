NEXT_PUBLIC_SIGNALING_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/vladimirhegai/DyadLab
DYADLAB_DATABASE_PATH=backend/dyadlab.db
DYADLAB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DYADLAB_SESSION_TTL_HOURS=24
DYADLAB_CREATE_RATE_LIMIT=12

# Configure a relay for real cross-network sessions. Use short-lived credentials
# from your TURN provider in production.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
